  {
   "@id": "https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#ExceptionalValueType",
   "@type": [
    "skos:ConceptScheme"
   ],
   "skos:prefLabel": "SDC4 exceptional values",
   "skos:definition": "The sixteen reasons the SDC4 reference model gives for a value being missing or outside its measurable range, each a restriction of ExceptionalValueType.",
   "schema:identifier": "https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#ExceptionalValueType",
   "schema:dateModified": "2026-10-08",
   "schema:url": "https://semanticdatacharter.com/ns/sdc4/sdc4.xsd",
   "schema:conditionsOfAccess": [
    "Defined in the SDC4 reference model schema https://semanticdatacharter.com/ns/sdc4/sdc4.xsd (SHA-256 0b828e51ef89142427e8659f498ccd409a77e452576d336a65bdb5e0cc495308)."
   ],
   "skos:hasTopConcept": [
    {
     "@id": "https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#NIType",
     "@type": [
      "skos:Concept"
     ],
     "skos:prefLabel": "No Information",
     "skos:notation": "NI",
     "skos:definition": "The value is exceptional (missing, omitted, incomplete, improper). No information as to the reason for being an exceptional value is provided. This is the most general exceptional value. It is also the default exceptional value.",
     "skos:inScheme": [
      {
       "@id": "https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#ExceptionalValueType"
      }
     ]
    },
    {
     "@id": "https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#MSKType",
     "@type": [
      "skos:Concept"
     ],
     "skos:prefLabel": "Masked",
     "skos:notation": "MSK",
     "skos:definition": "There is information on this item available but it has not been provided by the sender due to security, privacy or other reasons. There may be an alternate mechanism for gaining access to this information. Warning: Using this exceptional value does provide information that may be a breach of confidentiality, even though no detail data is provided. Its primary purpose is for those circumstances where it is necessary to inform the receiver that the information does exist without providing any detail.",
     "skos:inScheme": [
      {
       "@id": "https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#ExceptionalValueType"
      }
     ]
    },
    {
     "@id": "https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#INVType",
     "@type": [
      "skos:Concept"
     ],
     "skos:prefLabel": "Invalid",
     "skos:notation": "INV",
     "skos:definition": "The value as represented in the instance is not a member of the set of permitted data values in the constrained value domain of a variable.",
     "skos:inScheme": [
      {
       "@id": "https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#ExceptionalValueType"
      }
     ]
    },
    {
     "@id": "https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#DERType",
     "@type": [
      "skos:Concept"
     ],
     "skos:prefLabel": "Derived",
     "skos:notation": "DER",
     "skos:definition": "An actual value may exist, but it must be derived from the provided information; usually an expression is provided directly.",
     "skos:inScheme": [
      {
       "@id": "https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#ExceptionalValueType"
      }
     ]
    },
    {
     "@id": "https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#UNCType",
     "@type": [
      "skos:Concept"
     ],
     "skos:prefLabel": "Unencoded",
     "skos:notation": "UNC",
     "skos:definition": "No attempt has been made to encode the information correctly but the raw source information is represented, usually in free text.",
     "skos:inScheme": [
      {
       "@id": "https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#ExceptionalValueType"
      }
     ]
    },
    {
     "@id": "https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#OTHType",
     "@type": [
      "skos:Concept"
     ],
     "skos:prefLabel": "Other",
     "skos:notation": "OTH",
     "skos:definition": "",
     "skos:inScheme": [
      {
       "@id": "https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#ExceptionalValueType"
      }
     ]
    },
    {
     "@id": "https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#NINFType",
     "@type": [
      "skos:Concept"
     ],
     "skos:prefLabel": "Negative Infinity",
     "skos:notation": "NINF",
     "skos:definition": "Negative infinity of numbers",
     "skos:inScheme": [
      {
       "@id": "https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#ExceptionalValueType"
      }
     ]
    },
    {
     "@id": "https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#PINFType",
     "@type": [
      "skos:Concept"
     ],
     "skos:prefLabel": "Positive Infinity",
     "skos:notation": "PINF",
     "skos:definition": "Positive infinity of numbers",
     "skos:inScheme": [
      {
       "@id": "https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#ExceptionalValueType"
      }
     ]
    },
    {
     "@id": "https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#UNKType",
     "@type": [
      "skos:Concept"
     ],
     "skos:prefLabel": "Unknown",
     "skos:notation": "UNK",
     "skos:definition": "A proper value is applicable, but not known.",
     "skos:inScheme": [
      {
       "@id": "https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#ExceptionalValueType"
      }
     ]
    },
    {
     "@id": "https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#ASKRType",
     "@type": [
      "skos:Concept"
     ],
     "skos:prefLabel": "Asked and Refused",
     "skos:notation": "ASKR",
     "skos:definition": "Information was sought but refused to be provided (e.g., patient was asked but refused to answer).",
     "skos:inScheme": [
      {
       "@id": "https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#ExceptionalValueType"
      }
     ]
    },
    {
     "@id": "https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#NASKType",
     "@type": [
      "skos:Concept"
     ],
     "skos:prefLabel": "Not Asked",
     "skos:notation": "NASK",
     "skos:definition": "This information has not been sought (e.g., patient was not asked)",
     "skos:inScheme": [
      {
       "@id": "https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#ExceptionalValueType"
      }
     ]
    },
    {
     "@id": "https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#QSType",
     "@type": [
      "skos:Concept"
     ],
     "skos:prefLabel": "Sufficient Quantity",
     "skos:notation": "QS",
     "skos:definition": "The specific quantity is not known, but is known to non-zero and it is not specified because it makes up the bulk of the material; Add 10mg of ingredient X, 50mg of ingredient Y and sufficient quantity of water to 100mL.",
     "skos:inScheme": [
      {
       "@id": "https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#ExceptionalValueType"
      }
     ]
    },
    {
     "@id": "https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#TRCType",
     "@type": [
      "skos:Concept"
     ],
     "skos:prefLabel": "Trace",
     "skos:notation": "TRC",
     "skos:definition": "The content is greater or less than zero but too small to be quantified.",
     "skos:inScheme": [
      {
       "@id": "https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#ExceptionalValueType"
      }
     ]
    },
    {
     "@id": "https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#ASKUType",
     "@type": [
      "skos:Concept"
     ],
     "skos:prefLabel": "Asked but Unknown",
     "skos:notation": "ASKU",
     "skos:definition": "Information was sought but not found (e.g., patient was asked but did not know)",
     "skos:inScheme": [
      {
       "@id": "https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#ExceptionalValueType"
      }
     ]
    },
    {
     "@id": "https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#NAVType",
     "@type": [
      "skos:Concept"
     ],
     "skos:prefLabel": "Not Available",
     "skos:notation": "NAV",
     "skos:definition": "",
     "skos:inScheme": [
      {
       "@id": "https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#ExceptionalValueType"
      }
     ]
    },
    {
     "@id": "https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#NAType",
     "@type": [
      "skos:Concept"
     ],
     "skos:prefLabel": "Not Applicable",
     "skos:notation": "NA",
     "skos:definition": "No proper value is applicable in this context e.g.,the number of cigarettes smoked per day by a non-smoker subject.",
     "skos:inScheme": [
      {
       "@id": "https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#ExceptionalValueType"
      }
     ]
    }
